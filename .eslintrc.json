{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "QRCodeStyling": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-redeclare": "warn",
    "semi": ["warn", "always"]
  },
  "overrides": [
    {
      "files": ["e2e/**/*.js"],
      "env": {
        "node": true,
        "es2021": true
      },
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
