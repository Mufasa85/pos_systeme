{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/",
    "vendor/",
    ".git/",
    "public/osat-sfe-pwa/",
    "public/assets/",
    "app/",
    "docs/",
    "e2e/test-results/",
    "e2e/playwright-report/",
    "front-end/dist/",
    "*.sql",
    "*.lock"
  ],
  "globals": {
    "QRCodeStyling": "readonly"
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-redeclare": "warn",
    "semi": ["warn", "always"]
  },
  "overrides": [
    {
      "files": ["e2e/**/*.js"],
      "env": {
        "node": true,
        "es2021": true
      },
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
